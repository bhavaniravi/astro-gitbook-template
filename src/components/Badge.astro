---
interface Props {
  variant?: 'honey' | 'gray' | 'red';
  class?: string;
}

const { variant = 'gray', class: className } = Astro.props;
// Default to 14px, but let callers pick text-xs (12px minimum) without a Tailwind ordering fight.
const sizeClass = /\btext-(xs|sm|base)\b/.test(className || '') ? '' : 'text-sm';

const variants = {
  honey: 'bg-honey-100 dark:bg-honey-900/40 text-honey-900 dark:text-honey-200',
  gray: 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300',
  red: 'bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300',
};
---

<span class={`px-3 py-1 ${sizeClass} rounded-full shrink-0 ${variants[variant]} ${className || ''}`}>
  <slot />
</span>
