---
interface Props {
  title: string;
  href?: string;
  items?: any[];
  level?: number;
  idPrefix?: string;
}

const { title, href, items, level = 0, idPrefix = "nav" } = Astro.props;
const hasChildren = items && items.length > 0;

const normalize = (path: string) => path?.replace(/\/$/, "") || "";
const currentPath = normalize(Astro.url.pathname);

const isItemActive = (item: any): boolean => {
  if (item.href && normalize(item.href) === currentPath) return true;
  if (item.items && item.items.length > 0) {
    return item.items.some(isItemActive);
  }
  return false;
};

// Expand if any child tree contains the active link
const isExpanded = hasChildren && items.some(isItemActive);

// Check if this specific item is active
const isActive = href && normalize(href) === currentPath;
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const contentId = `${idPrefix}-${level}-${slugify(title)}-${slugify(href || "")}`;
---

<div class="nav-item-wrapper" data-nav-level={level}>
  {hasChildren ? (
    <div class="nav-collapsible">
      <div
        class:list={[
          "flex items-center justify-between rounded-md transition-colors",
          isActive
            ? "bg-honey-100 dark:bg-honey-900/30 text-honey-900 dark:text-honey-100"
            : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800"
        ]}
      >
        {href ? (
          <a
            href={href}
            aria-current={isActive ? "page" : undefined}
            data-active-link={isActive}
            class:list={["flex-1 min-w-0 truncate px-2 py-1.5 text-sm font-medium rounded-md", isActive ? "" : "hover:underline"]}
          >
            {title}
          </a>
        ) : (
          <button
            type="button"
            class="nav-toggle flex-1 min-w-0 truncate text-left px-2 py-1.5 text-sm font-medium rounded-md"
            aria-expanded={isExpanded ? "true" : "false"}
            aria-controls={contentId}
          >
            {title}
          </button>
        )}
        <button
          type="button"
          class="nav-toggle shrink-0 px-2 py-1.5 rounded-md"
          aria-label={`Toggle ${title} section`}
          aria-expanded={isExpanded ? "true" : "false"}
          aria-controls={contentId}
        >
          <svg
            class="chevron w-4 h-4 transition-transform"
            class:list={[isExpanded ? 'rotate-90' : '']}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
      <div id={contentId} class="nav-content pl-3 space-y-0.5" class:list={[isExpanded ? '' : 'hidden']}>
        {items.map(item => (
          <Astro.self {...item} level={level + 1} idPrefix={idPrefix} />
        ))}
      </div>
    </div>
  ) : (
    <a
      href={href}
      target={href?.startsWith('http') ? '_blank' : undefined}
      rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
      class:list={[
        "text-sm block px-2 py-1.5 rounded-md transition-colors truncate flex items-center justify-between",
        isActive
          ? "bg-honey-100 dark:bg-honey-900/30 text-honey-900 dark:text-honey-100 font-medium"
          : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-800"
      ]}
      title={title}
      data-active-link={isActive}
      aria-current={isActive ? "page" : undefined}
    >
      <span>{title}</span>
      {href?.startsWith('http') && (
        <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      )}
    </a>
  )}
</div>

<script>
  function initNav() {
    document.querySelectorAll('.nav-toggle').forEach(button => {
      // Avoid multiple listeners
      if (button.getAttribute('data-nav-listener')) return;
      button.setAttribute('data-nav-listener', 'true');

      button.addEventListener('click', (e) => {
        const wrapper = (e.currentTarget as HTMLElement).closest('.nav-collapsible');
        if (!wrapper) return;
        const content = wrapper.querySelector(':scope > .nav-content') as HTMLElement | null;
        const chevron = wrapper.querySelector('.chevron');
        const toggles = wrapper.querySelectorAll(':scope > div > .nav-toggle');
        if (!content) return;
        const open = content.classList.contains('hidden');
        content.classList.toggle('hidden', !open);
        chevron?.classList.toggle('rotate-90', open);
        toggles.forEach(t => t.setAttribute('aria-expanded', open ? 'true' : 'false'));
      });
    });
  }

  // Initialize on load and after swaps
  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
