---
interface Props {
  message: string;
  url: string;
  linkText?: string;
  id?: string;
}
const { message, url, linkText = "Register Now", id = "default" } = Astro.props;
---

<div id="announcement-banner" data-banner-id={id} class="sticky top-16 z-40 w-full bg-honey-800 dark:bg-honey-900 text-honey-50 text-sm" role="region" aria-label="Announcement">
  <div class="relative px-12 py-2.5 text-center">
    <span>{message}</span>
    <a href={url} target="_blank" rel="noopener" class="ml-2 underline font-semibold hover:text-honey-200 transition-colors">{linkText} →</a>
    <button id="dismiss-banner" type="button" aria-label="Dismiss announcement" class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center min-w-10 min-h-10 text-honey-50/80 hover:text-white transition-colors text-xl leading-none rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-honey-50">×</button>
  </div>
</div>

<script>
  function initBanner() {
    const banner = document.getElementById('announcement-banner');
    if (!banner) return;
    const STORAGE_KEY = 'announcement-banner-dismissed-' + (banner.dataset.bannerId || 'default');

    if (localStorage.getItem(STORAGE_KEY)) {
      banner.remove();
      return;
    }

    const link = banner.querySelector('a');
    link?.addEventListener('click', () => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'announcement_banner_clicked', {
          event_category: 'engagement',
          event_label: window.location.pathname,
        });
      }
    });

    const btn = document.getElementById('dismiss-banner');
    btn?.addEventListener('click', () => {
      localStorage.setItem(STORAGE_KEY, '1');
      banner.remove();
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'announcement_banner_dismissed', {
          event_category: 'engagement',
          event_label: window.location.pathname,
        });
      }
    });
  }

  initBanner();
  document.addEventListener('astro:after-swap', initBanner);
</script>
