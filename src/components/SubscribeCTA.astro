---
interface Props {
  rssUrl?: string;
  newsletterUrl?: string;
}

const { rssUrl = "/rss.xml", newsletterUrl = "" } = Astro.props;
---

<aside
  aria-labelledby="subscribe-heading"
  class="mt-12 rounded-lg border border-gray-200 dark:border-gray-700 p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
>
  <div>
    <h2 id="subscribe-heading" class="text-base font-semibold text-gray-900 dark:text-gray-100">
      Get new posts by RSS
    </h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Follow along in your feed reader. No spam, no tracking.
    </p>
  </div>
  <div class="flex flex-wrap items-center gap-3 shrink-0">
    <a
      href={rssUrl}
      class="inline-flex items-center gap-2 rounded-md border border-gray-300 dark:border-gray-600 px-3 py-2 text-sm font-medium text-gray-900 dark:text-gray-100 hover:border-honey-500 hover:text-honey-700 dark:hover:border-honey-400 dark:hover:text-honey-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-600 dark:focus-visible:outline-honey-400 transition-colors"
    >
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="19" r="2"></circle>
        <path d="M3 10a1 1 0 0 1 1-1 11 11 0 0 1 11 11 1 1 0 1 1-2 0 9 9 0 0 0-9-9 1 1 0 0 1-1-1z"></path>
        <path d="M3 3a1 1 0 0 1 1-1 18 18 0 0 1 18 18 1 1 0 1 1-2 0A16 16 0 0 0 4 4a1 1 0 0 1-1-1z"></path>
      </svg>
      RSS feed
    </a>
    {newsletterUrl && (
      <a
        href={newsletterUrl}
        class="inline-flex items-center rounded-md bg-honey-500 dark:bg-honey-400 px-3 py-2 text-sm font-medium text-ink-900 hover:bg-honey-400 dark:hover:bg-honey-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-honey-600 dark:focus-visible:outline-honey-400 transition-colors"
      >
        Join the newsletter
      </a>
    )}
  </div>
</aside>
