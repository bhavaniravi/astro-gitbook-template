---
import Base from "./Base.astro";
import TopNav from "../components/TopNav.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  googleAnalyticsId?: string;
  googleAdsenseClient?: string;
  productionHostname?: string;
  // Navigation Data
  navData: {
    sections: any[];
    // Backwards compatibility
    categoryTree?: any;
    sortedCategories?: string[];
  };
  video?: {
    title: string;
    description: string;
    thumbnailUrl: string;
    uploadDate: string;
    embedUrl: string;
    duration?: string;
  };
  announcement?: { enabled?: boolean; message?: string; url?: string; linkText?: string; id?: string };
  schema?: any;
  ogType?: 'website' | 'article';
  publishedTime?: string | Date;
  modifiedTime?: string | Date;
}

const {
  title,
  description,
  image,
  googleAnalyticsId,
  googleAdsenseClient,
  productionHostname,
  navData,
  video,
  schema,
  ogType,
  publishedTime,
  modifiedTime,
  announcement,
} = Astro.props;
const showBanner = !!(announcement?.enabled && announcement.message && announcement.url);
---

<Base
  title={title}
  description={description}
  image={image}
  googleAnalyticsId={googleAnalyticsId}
  googleAdsenseClient={googleAdsenseClient}
  productionHostname={productionHostname}
  video={video}
  schema={schema}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-md focus:bg-honey-500 focus:text-ink-900 focus:font-semibold focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-ink-900 dark:focus:outline-honey-100"
  >
    Skip to main content
  </a>

  <!-- Top Navigation -->
  <TopNav />

  <!-- Mobile Navigation -->
  <MobileNav sections={navData.sections} />

  <!-- Desktop Sidebar -->
  <div class="hidden md:block">
    <Sidebar sections={navData.sections} />
  </div>

  <!-- Main Content Area -->
  <main
    id="main-content"
    tabindex="-1"
    class="min-h-screen focus:outline-none pt-16 md:ml-[calc(max(2rem,calc((100vw-1400px)/2))+18rem)] md:mr-[max(2rem,calc((100vw-1400px)/2))]"
  >
    {showBanner && (
      <AnnouncementBanner
        message={announcement!.message!}
        url={announcement!.url!}
        linkText={announcement!.linkText}
        id={announcement!.id}
      />
    )}
    <slot />
  </main>
</Base>
