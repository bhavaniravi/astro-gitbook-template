---
import MainLayout from "./MainLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHeader from "../components/PageHeader.astro";
import CodeCopyButton from "../components/CodeCopyButton.astro";
import ImageViewer from "../components/ImageViewer.astro";
import SubscribeCTA from "../components/SubscribeCTA.astro";
import PrevNextNav from "../components/PrevNextNav.astro";
import type { CollectionEntry } from "astro:content";

interface PostLink {
  title: string;
  href: string;
}

interface Props {
  post: CollectionEntry<"notes">;
  navData: any;
  prev?: PostLink;
  next?: PostLink;
  googleAnalyticsId?: string;
  googleAdsenseClient?: string;
  productionHostname?: string;
  siteName?: string; // For meta description fallback
  descriptionFallback?: string; // Derived from body when frontmatter has no description
  wordCount?: number;
  authorNode?: Record<string, any>; // Schema.org author ({ '@id': ... } to link to a Person entity)
  publisherNode?: Record<string, any>;
  extraGraph?: Record<string, any>[]; // Extra JSON-LD nodes (Person, WebSite, ...)
  newsletterUrl?: string; // Optional; empty = RSS only
  announcement?: { enabled?: boolean; message?: string; url?: string; linkText?: string; id?: string };
}

const {
  post,
  navData,
  prev,
  next,
  googleAnalyticsId,
  googleAdsenseClient,
  productionHostname,
  siteName,
  descriptionFallback,
  wordCount,
  authorNode,
  publisherNode,
  extraGraph = [],
  newsletterUrl = "",
  announcement,
} = Astro.props;
const { title, pubDate, description, sub_title, tags = [], featuredImgPath: rawFeaturedImg } = post.data;
const _resolvedImg = rawFeaturedImg
  ? (typeof rawFeaturedImg === 'string' ? rawFeaturedImg : rawFeaturedImg.src)
  : undefined;
// /@fs/... = Vite dev-server internal path; ./ or ../ = relative path that can't be a URL
const featuredImgPath =
  _resolvedImg && !_resolvedImg.startsWith('/@') && !_resolvedImg.startsWith('.')
    ? _resolvedImg
    : undefined;

// Extract category from post ID
const idParts = post.id.split("/");
const category = idParts[0];
// Only a real subcategory folder (category/sub/file.md) has a landing page
const subcategory = idParts.length > 2 ? idParts[1] : undefined;
const catLabels: Record<string, string> = { ai: "AI", devops: "DevOps", fastapi: "FastAPI" };
const fmt = (c: string) =>
  catLabels[c] ?? c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

// Use sub_title as fallback description
const metaDescription =
  description ||
  sub_title ||
  descriptionFallback ||
  (siteName ? `Read ${title} on ${siteName}` : `Read ${title}`);

// Structured Data
const breadcrumbItems = [
  { name: "Home", item: Astro.site?.toString() || "" },
  { name: "Blog", item: new URL("/blog", Astro.site).toString() },
  { name: fmt(category), item: new URL(`/blog/${category}`, Astro.site).toString() },
  ...(subcategory
    ? [{ name: fmt(subcategory), item: new URL(`/blog/${category}/${subcategory}`, Astro.site).toString() }]
    : []),
  { name: title, item: new URL(Astro.url.pathname, Astro.site).toString() },
];

const toISO = (d: any) => {
  const t = new Date(d);
  return isNaN(t.getTime()) ? undefined : t.toISOString();
};
const publishedISO = toISO(pubDate);
const modifiedISO = toISO((post.data as any).updatedDate || (post.data as any).lastmod || pubDate);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": new URL(Astro.url.pathname, Astro.site).toString(),
      headline: title,
      description: metaDescription,
      image: featuredImgPath
        ? new URL(featuredImgPath, Astro.site).toString()
        : undefined,
      datePublished: publishedISO,
      dateModified: modifiedISO,
      url: new URL(Astro.url.pathname, Astro.site).toString(),
      inLanguage: "en",
      articleSection: fmt(category),
      keywords: tags.length ? tags.join(", ") : undefined,
      wordCount: wordCount || undefined,
      author: authorNode ?? { "@type": "Person", name: "Bhavani Ravi", url: Astro.site?.toString() },
      publisher: publisherNode ?? authorNode ?? { "@type": "Person", name: siteName || "Bhavani Ravi" },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": new URL(Astro.url.pathname, Astro.site).toString(),
      },
    },
    ...extraGraph,
    {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: item.item,
      })),
    },
  ],
};
---

<MainLayout
  title={title}
  description={metaDescription}
  image={featuredImgPath || undefined}
  navData={navData}
  googleAnalyticsId={googleAnalyticsId}
  googleAdsenseClient={googleAdsenseClient}
  productionHostname={productionHostname}
  schema={structuredData}
  ogType="article"
  tags={tags}
  author={authorNode?.name || siteName}
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  announcement={announcement}
>
  <article class="max-w-4xl mx-auto px-6 lg:px-8 py-8 lg:py-12">
    <Breadcrumbs category={category} subcategory={subcategory} title={title} />

    <PageHeader
      title={title}
      subtitle={sub_title || undefined}
      date={pubDate}
    />

    <div class="prose prose-lg dark:prose-dark max-w-none">
      <slot />
    </div>

    <SubscribeCTA newsletterUrl={newsletterUrl} />
  </article>

  <PrevNextNav prev={prev} next={next} />

  <CodeCopyButton />
  <ImageViewer />
</MainLayout>
